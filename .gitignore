# Environment variables lokal (rahasia jangan sampai ter-commit ke git)
.env
.env.local
.env.*.local
.env*.local
*.pem
*.key

# Dependency & build artifacts
node_modules/
.vercel/
.vercel_cache/

# Log & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
.cache/

# OS and Editor metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Arsip & file kompresi besar
*.zip
*.rar
*.7z
*.tar.gz

# Berkas media video berukuran besar (>50MB/100MB)
# Catatan: GitHub membatasi ukuran maksimal file 100MB per file.
# Jika video yang kamu upload nantinya berukuran sangat besar (>50MB), 
# kamu bisa meng-uncomment baris di bawah agar tidak membebani repo:
# *.mp4
# *.mov
# *.avi
# *.mkv
